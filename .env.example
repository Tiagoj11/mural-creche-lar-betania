# Exemplo de configuração LOCAL para o Lote 2. Copie para .env (não versionar).
# Senha administrativa: defina uma senha forte apenas no ambiente; nunca commite.
ADMIN_SECRET_KEY=SUBSTITUA_POR_SEGREDO_LOCAL_NAO_VERSIONADO
PORT=3000

# Caminho ABSOLUTO fora do checkout; crie-o antes de iniciar o servidor.
# Linux/macOS: substitua <usuario> pelo usuário real do processo.
MURAL_UPLOAD_DIR=/home/<usuario>/Downloads/Mural Creche

# Na futura VM, configure por segredo/variável de ambiente do serviço, não neste arquivo:
# MURAL_UPLOAD_DIR=/srv/mural-creche/uploads
# A pasta deve pertencer ao usuário não-root do processo e ter permissões restritas.
# Este exemplo não configura Oracle, deploy, DNS nem HTTPS.
