# EXEMPLO, NUNCA UM ARQUIVO DE SEGREDOS REAIS.
# O sistema administrativo por sessão será ativado somente após integração
# autorizada de Backend + Frontend + migração offline explícita do SQLite.
NODE_ENV=production
PORT=3000
MURAL_DB_PATH=/srv/mural-creche/state/banco.db
MURAL_UPLOAD_DIR=/srv/mural-creche/uploads

# Autenticação administrativa — bootstrap SEMPRE FECHADO por padrão.
# Nome de flag e janela a confirmar pelo Backend antes da aplicação operacional.
# False não substitui a checagem obrigatória do Backend.
ADMIN_BOOTSTRAP_ENABLED=false
# Janela máxima inicial proposta: 15 minutos, com expiração validada no servidor.
ADMIN_BOOTSTRAP_WINDOW_MINUTES=15
# ADMIN_BOOTSTRAP_TOKEN=<SEGREDO_ALEATORIO_DE_ALTA_ENTROPIA_SOMENTE_NO_SERVIDOR>
# O valor verdadeiro NUNCA pertence a este modelo, Git, Drive ou CI.
# Operador deve ativar janela via SSH/console, com deadline, somente após backup
# e autorização; após primeira credencial, desativar/remover flag e token.

# A origem oficial HTTPS será definida no gate operacional, sem URL inventada.
# ADMIN_CANONICAL_ORIGIN=https://<DOMINIO_APROVADO>
# Express deve aceitar apenas proxy local confiável e garantir HTTPS em produção.
# Nunca usar trust proxy=true genericamente.

# Legado: ADMIN_SECRET_KEY era necessário na V1 ANTERIOR À MIGRAÇÃO.
# NÃO manter esta variável como autenticação alternativa após o cutover.
# ADMIN_SECRET_KEY=<SOMENTE_VERSAO_LEGADA_JA_APROVADA>
# Sem criação automática de banco externo vazio, migração ou senha.
