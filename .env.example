# MODELO SEM SEGREDOS REAIS. Nunca versionar .env ou /etc/mural-creche/mural.env.
# IMPORTANTE: para VM Lote 3, aguardar aceite do Backend para MURAL_DB_PATH.
# As linhas a seguir são exemplos, não configurações já instaladas.
ADMIN_SECRET_KEY=SUBSTITUA_POR_SEGREDO_FORTE_GERADO_FORA_DO_REPOSITORIO
PORT=3000

# Instalação local: ambas devem ser absolutas; uploads fora do checkout.
# Se MURAL_UPLOAD_DIR não for definida, o Backend usa ~/Downloads/Mural Creche.
# MURAL_UPLOAD_DIR=/home/USUARIO/Downloads/Mural Creche
# VM autorizada (usuário não-root mural; diretórios persistentes 0700):
MURAL_UPLOAD_DIR=/srv/mural-creche/uploads
MURAL_DB_PATH=/srv/mural-creche/state/banco.db

# NÃO utilizar MURAL_DB_PATH em produção antes de o Backend comprovar
# suporte ao caminho externo, preservação de IDs e ausência de migração implícita.
# Serviço systemd deve carregar credencial REAL via EnvironmentFile 0600,
# gerenciado pelo operador fora do Git e sem mostrar o conteúdo em logs.
